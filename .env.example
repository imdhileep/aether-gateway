# Provider API keys (set the ones you use; the `mock` model needs none).
# Each provider supports a COMMA-SEPARATED list of keys for load balancing.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Admin key — protects /admin/* endpoints (key management).
# Generate one: openssl rand -hex 24
GATEWAY_ADMIN_KEY=

# Optional: override config path
# GATEWAY_CONFIG=./gateway.config.yaml

# Optional: server port (overrides config)
# PORT=8787
