{
  "name": "aether-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aether — an AI-powered LLM gateway: one OpenAI-compatible API in front of OpenAI, Anthropic & Gemini with semantic caching, smart failover, guardrails, virtual keys & cost analytics.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed-key": "tsx scripts/seed-key.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "tsx": "^4.19.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
